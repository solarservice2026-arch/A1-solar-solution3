{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build -w @a1/validation && npm run build -w @a1/web",
  "outputDirectory": "apps/web/dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://a1-solar-api.onrender.com/api/:path*"
    },
    {
      "source": "/((?!api/|assets/|robots.txt|sitemap.xml).*)",
      "destination": "/index.html"
    }
  ]
}
