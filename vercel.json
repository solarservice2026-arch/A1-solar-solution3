{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build -w @a1/validation && npm run build -w @a1/api && npm run build -w @a1/web",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/((?!api/|assets/|robots.txt|sitemap.xml).*)",
      "destination": "/index.html"
    }
  ]
}
